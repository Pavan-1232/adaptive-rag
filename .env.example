# Copy to .env to override defaults. The real .env is gitignored.
# ADAPTIVE_RAG_DATA_DIR=data
# ADAPTIVE_RAG_OLLAMA_HOST=http://localhost:11434
# ADAPTIVE_RAG_LLM_MODEL=qwen3.5:9b
# ADAPTIVE_RAG_EMBEDDING_MODEL=embeddinggemma:300m
# ADAPTIVE_RAG_CHUNKING=C1   # opt-in: adaptive (optimizer, ~10 min per new document) or C7 (table-aware)
# Cloud answer models (Stage 6, bring your own key). Ollama stays the default. A cloud model is
# used only when a query asks for it AND the knowledge base has allow_cloud on, because document
# text leaves this machine. Keys are never logged, traced or stored. Never commit a real key.
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# ADAPTIVE_RAG_OPENAI_MODEL=gpt-6-luna
# ADAPTIVE_RAG_GEMINI_MODEL=gemini-3.5-flash-lite
# ADAPTIVE_RAG_ANTHROPIC_MODEL=claude-haiku-5-5
